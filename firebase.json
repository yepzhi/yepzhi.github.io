{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git",
      ".firebase",
      ".firebaserc",
      ".gitignore",
      ".DS_Store",
      ".nojekyll",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/richmond-token-check",
        "destination": "https://huggingface.co/spaces/yepzhi/richmond-token-check",
        "type": 301
      },
      {
        "source": "/richmond-token-check/**",
        "destination": "https://huggingface.co/spaces/yepzhi/richmond-token-check",
        "type": 301
      }
    ]
  }
}